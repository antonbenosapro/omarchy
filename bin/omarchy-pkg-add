#!/bin/bash

# omarchy:summary=Install packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true

if omarchy-pkg-missing "$@"; then
  if command -v pacman &>/dev/null; then
    if (( EUID == 0 )); then
      pacman -S --noconfirm --needed -- "$@" || exit 1
    else
      sudo pacman -S --noconfirm --needed -- "$@" || exit 1
    fi
  else
    if (( EUID == 0 )); then
      apt-get update -qq && apt-get install -y --no-install-recommends "$@" || exit 1
    else
      sudo apt-get update -qq && sudo apt-get install -y --no-install-recommends "$@" || exit 1
    fi
  fi
fi

for pkg in "$@"; do
  if ! omarchy-pkg-present "$pkg"; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
